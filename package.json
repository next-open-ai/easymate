{
  "name": "@next-open-ai/easymate",
  "version": "0.4.30",
  "private": false,
  "description": "Cross-platform local AI workspace.",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "easymate": "./bin/easymate.mjs"
  },
  "files": [
    "bin",
    "apps/api/dist",
    "apps/renderer/dist",
    "scripts/start-web.mjs",
    "scripts/lib",
    "runtimes/python-runtime/src",
    "runtimes/python-runtime/requirements.txt",
    "runtimes/python-runtime/pyproject.toml",
    "README.md",
    "README-EN.md",
    "LICENSE",
    "docs",
    "apps/gateway/package.json",
    "apps/gateway/dist",
    "packages/channel/package.json",
    "packages/channel/dist"
  ],
  "dependencies": {
    "@easymate/channel": "file:./packages/channel",
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.1.1",
    "@lancedb/lancedb": "0.22.3",
    "@larksuiteoapi/node-sdk": "^1.11.1",
    "apache-arrow": "18.1.0",
    "fastify": "^5.3.0",
    "fflate": "^0.8.3",
    "sql.js": "^1.14.2",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "dev": "pnpm --filter @easymate/desktop dev",
    "web:build": "pnpm build",
    "web:start": "node scripts/start-web.mjs",
    "easymate:start": "node bin/easymate.mjs start",
    "easymate:init": "node bin/easymate.mjs init",
    "easymate:doctor": "node bin/easymate.mjs doctor",
    "build": "pnpm --filter @easymate/contracts build && pnpm --filter @easymate/tools build && pnpm --filter @easymate/storage build && pnpm --filter @easymate/ui-kit build && pnpm --filter @easymate/channel build && pnpm --filter @easymate/gateway build && pnpm --filter @easymate/agent-core build && pnpm --filter @easymate/orchestrator build && pnpm --filter @easymate/api build && pnpm --filter @easymate/renderer build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "tasks:smoke": "node scripts/template-tasks-smoke.mjs",
    "lint": "pnpm -r --if-present lint",
    "package": "pnpm --filter @easymate/desktop package",
    "size:check": "node scripts/check-size.mjs",
    "product:regression": "node scripts/easymate-product-regression.mjs",
    "orch:smoke": "pnpm --filter @easymate/api build && node scripts/run-orch-smoke.mjs",
    "auth:regression": "pnpm --filter @easymate/api build && node scripts/auth-regression.mjs",
    "audit:regression": "pnpm --filter @easymate/api build && node scripts/audit-regression.mjs",
    "e2e:web": "pnpm build && playwright test --project=web-chromium",
    "e2e:electron": "pnpm build && playwright test --project=electron",
    "e2e": "pnpm e2e:web && pnpm e2e:electron",
    "orch:remote-confirm": "node scripts/remote-project-confirm.mjs",
    "orch:remote-chat": "node scripts/remote-chat.mjs",
    "chat-attachments:regression": "pnpm --filter @easymate/agent-core build && pnpm --filter @easymate/orchestrator build && pnpm --filter @easymate/api build && node scripts/chat-attachments-regression.mjs",
    "durable-task:regression": "node scripts/durable-task-regression.mjs",
    "gateway:stub": "node scripts/gateway-stub-smoke.mjs",
    "gateway:config": "node scripts/gateway-config.mjs",
    "gateway:feishu": "node scripts/gateway-feishu-smoke.mjs",
    "gateway:relay": "node scripts/relay-smoke.mjs",
    "esight:contracts:regression": "pnpm --filter @easymate/contracts build && node scripts/esight-contracts-regression.mjs",
    "mcp:user-scope:regression": "node scripts/mcp-user-scope-regression.mjs",
    "manual:generate": "node scripts/generate-user-manual.mjs",
    "manual:images": "node scripts/optimize-user-manual-images.mjs",
    "manual:regression": "pnpm --filter @easymate/renderer build && node scripts/user-manual-regression.mjs",
    "concurrency:loadtest": "node scripts/concurrency-loadtest.mjs",
    "owner:migrate:check": "node scripts/migrate-owner-fields.mjs",
    "owner:migrate": "node scripts/migrate-owner-fields.mjs --write"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitepress": "2.0.0-alpha.20",
    "ws": "^8.18.0"
  }
}
